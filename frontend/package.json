{
  "name": "news-frontend",
  "version": "1.0.0",
  "description": "News application frontend with authentication",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
