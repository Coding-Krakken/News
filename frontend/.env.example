# =============================================================================
# Frontend - Local Development Configuration
# =============================================================================
# For Vite, environment variables must be prefixed with VITE_
# Copy this file to .env.local for local development overrides

# API Configuration
# For local development, use proxy configured in vite.config.js
# The proxy forwards /api requests to http://localhost:8000
VITE_API_BASE_URL=/api

# Environment
VITE_ENVIRONMENT=local
