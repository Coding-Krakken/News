# =============================================================================
# Frontend - Production Deployment (Vercel)
# =============================================================================
# Set these environment variables in Vercel dashboard:
# Project Settings > Environment Variables

# API Configuration
# Set this to your backend API URL (deployed on Railway, Render, etc.)
# Example: https://your-backend-api.railway.app
VITE_API_BASE_URL=https://your-backend-api.railway.app/api

# Environment
VITE_ENVIRONMENT=production

# Note: For Vercel preview deployments, you can set VITE_API_BASE_URL
# to a different value (like a staging backend) to test against staging data
