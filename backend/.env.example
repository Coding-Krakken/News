# =============================================================================
# News Analytics Platform - Local Development (Docker Compose)
# =============================================================================
# Copy this file to .env and fill in your values
# This configuration is for LOCAL development using Docker Compose

# Environment
ENVIRONMENT=local

# Database Configuration
# For Docker Compose: Use the service name 'mongodb' defined in docker-compose.yml
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=news_analytics

# API Configuration
# For local development with Docker
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# OpenAI Configuration (Optional)
# Required for AI-powered fact-checking features
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Security
# For local development, the default is fine
# In production, generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# CORS Configuration
# Comma-separated list of allowed origins
# For local development with Vite dev server
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

