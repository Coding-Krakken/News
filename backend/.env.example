## Backend Environment Example

# This file contains example environment variables used by the repository.
# It includes settings for the Node.js/Postgres backend (auth, bookmarks, filters)
# as well as for optional analytics services that use MongoDB/OpenAI.

#########################
# Node.js Backend (Postgres)
#########################
# Server Configuration
NODE_ENV=development
PORT=3000

# Postgres Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=news_db
DB_USER=news_user
DB_PASSWORD=news_password

# Test Database Configuration
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=news_test_db
TEST_DB_USER=news_user
TEST_DB_PASSWORD=news_password

# JWT Configuration
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security Configuration
BCRYPT_ROUNDS=12
COOKIE_SECRET=your-cookie-secret-change-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# CORS Configuration for frontend dev server
CORS_ORIGIN=http://localhost:3001

#########################
# Analytics Services (Optional - MongoDB / FastAPI / OpenAI)
#########################
# Environment for analytics/AI services (if used)
ENVIRONMENT=local

# MongoDB (for analytics services)
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=news_analytics

# API / Frontend URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# OpenAI Configuration (Optional)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Security for analytics services
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting for analytics services
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

#########################
# Logging
LOG_LEVEL=info

