# =============================================================================
# News Analytics Platform - Production Deployment (Vercel, Railway, etc.)
# =============================================================================
# This configuration is for PRODUCTION deployment
# Use this as a reference for setting environment variables in your hosting platform

# Environment
ENVIRONMENT=production

# Database Configuration
# Use MongoDB Atlas or other cloud MongoDB provider
# Example: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/news_analytics?retryWrites=true&w=majority
DATABASE_NAME=news_analytics

# API Configuration
# Set these to your production URLs
# Backend API URL (if deployed separately from frontend)
API_BASE_URL=https://your-backend-api.railway.app
# Frontend URL (Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# OpenAI Configuration (Optional)
# Required for AI-powered fact-checking features
# Store this as a secret in your hosting platform
OPENAI_API_KEY=sk-your-production-openai-key

# Security
# ⚠️ CRITICAL: Generate a secure secret key for production!
# Generate with: openssl rand -hex 32
# Store this as a secret in your hosting platform
SECRET_KEY=generate-a-secure-key-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# CORS Configuration
# Set to your production frontend URL(s)
# Add both your production domain and any preview domains
CORS_ORIGINS=https://your-app.vercel.app,https://*.vercel.app

# Logging
LOG_LEVEL=INFO
